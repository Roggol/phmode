  "messages": [
    {
      "id": "DistortionWorldGiratinaRoom_Text_GiratinaCryGiygogagogwoh",
      "en_US": "Giygogagogwoh!"
    },
    {
      "id": "DistortionWorldGiratinaRoom_Text_GiratinaIsEyeingPlayer",
      "en_US": [
        "GIRATINA is quietly eyeing\n",
        "{STRVAR_1 3, 0, 0}..."
      ]
    },
    {
      "id": "DistortionWorldGiratinaRoom_Text_GiratinaCryGiygogagohgwooh",
      "en_US": "Giygogagohgwooh!\r"
    },
    {
      "id": "DistortionWorldGiratinaRoom_Text_GiratinaUnderstoodUs",
      "en_US": [
        "Cynthia: GIRATINA seems to have\n",
        "understood us!\r"
      ]
    },
    {
      "id": "DistortionWorldGiratinaRoom_Text_ThatPokemonWasDefeated",
      "en_US": [
        "Cyrus: GIRATINA...\r",
        "Where did it go?!\r"
      ]
    },
    {
      "id": "DistortionWorldGiratinaRoom_Text_ThatPokemonWasCaptured",
      "en_US": [
        "Cyrus: GIRATINA...\r",
        "Where did it go?!\r"
      ]
    },
    {
      "id": "DistortionWorldGiratinaRoom_Text_YouRefusedToBattle",
      "en_US": [
        "Cyrus: GIRATINA...\r",
        "Where did it go?!\r"
      ]
    },
    {
      "id": "DistortionWorldGiratinaRoom_Text_NewWorldCantBeMade",
      "en_US": [
        "How can it have just gone?\r",
        "I was going to create a new world!\r",
        "I was going to make a world\n",
        "without joy or suffering!\r",
        "I was going to make a world\n",
        "without love or hate!\r",
        "I was going to make a world\n",
        "without hope or despair!\r",
        "I was going to make people\n",
        "understand how... I feel...\r"
      ]
    },
    {
      "id": "DistortionWorldGiratinaRoom_Text_PokemonUniteUs",
      "en_US": [
        "Cynthia: ...The places we are\n",
        "born.\r",
        "The time we spend living...\r",
        "The languages we speak...\r",
        "We are all different. But the\n",
        "presence of Pokémon unites us.\r",
        "We share our lives with our\n",
        "Pokémon, and our happiness grows\r",
        "as we all\f",
        "become greater than we were alone.\r",
        "That is why we can battle and\n",
        "trade with anyone we choose...\r",
        "That’s why we keep living.\r",
        "We accept the duality of joy and\n",
        "suffering, love and hate, hope and\r",
        "despair.\r",
        "Perhaps there is no meaning to any\n",
        "of it.\r",
        "So why not have fun with our\n",
        "Pokémon while we can?\r"
      ]
    },
    {
      "id": "DistortionWorldGiratinaRoom_Text_BigSilence",
      "en_US": "{SIZE 200}Silence!{SIZE 100}\r"
    },
    {
      "id": "DistortionWorldGiratinaRoom_Text_EnoughBlathering",
      "en_US": [
        "Cyrus: Enough of your blathering!\r",
        "Meaningless sentiment!\r",
        "There is no purpose to existence!\r",
        "It is better to return to nothing.\r",
        "Oblivion is kind.\r",
        "Oblivion is merciful.\r",
        "Oblivion is the only truth.\r",
        "Why doesn’t anyone understand\n",
        "that?\r",
        "I will stay here and wait for the\n",
        "end.\r"
      ]
    },
    {
      "id": "DistortionWorldGiratinaRoom_Text_WeCanFeelJoy",
      "en_US": [
        "Cynthia: I feel sorry for you,\n",
        "Cyrus..."
      ]
    },
    {
      "id": "DistortionWorldGiratinaRoom_Text_LetsGoBackHome",
      "en_US": [
        "We have to go back.\r",
        "If the portal stays open much\n",
        "longer we risk tearing reality\r",
        "apart.\r",
        "I’m sure GIRATINA will visit us\n",
        "again someday.\r",
        "The portal where GIRATINA was\n",
        "should lead back to our world.\r"
      ]
    },
    {
      "id": "DistortionWorldGiratinaRoom_Text_LeapIntoPortal",
      "en_US": [
        "There is a portal where GIRATINA\n",
        "was. Will you leap into the\r",
        "portal?"
      ]
    },
    {
      "id": "DistortionWorldGiratinaRoom_Text_PlayerLeaptIntoPortal",
      "en_US": "{STRVAR_1 3, 0, 0} leapt into the portal.\r"
    }
  ]
}
