  "messages": [
    {
      "id": "LakeVerityLowWater_Text_WhatsGoingOn",
      "en_US": "{STRVAR_1 3, 0, 0}: What’s going on...?\r"
    },
    {
      "id": "LakeVerityLowWater_Text_MakeTimeAndSpaceMine",
      "en_US": [
        "One last look...\n"
      ]
    },
    {
      "id": "LakeVerityLowWater_Text_AllowMeToPass",
      "en_US": [
        "Allow me to pass."
      ]
    },
    {
      "id": "LakeVerityLowWater_Text_WhatWasThatAbout",
      "en_US": [
        "{STRVAR_1 3, 0, 0}: That guy seemed sad.\n",
        "I wonder why...\r"
      ]
    },
    {
      "id": "LakeVerityLowWater_Text_LetsCatchThatLegendary",
      "en_US": [
        "OK, {STRVAR_1 3, 1, 0}! Let’s\n",
        "catch that legendary Pokémon!\r"
      ]
    },
    {
      "id": "LakeVerityLowWater_Text_LegendaryCry",
      "en_US": "Kyauuun!\r"
    },
    {
      "id": "LakeVerityLowWater_Text_ThatWasTheLegendaryCrying",
      "en_US": [
        "{STRVAR_1 3, 0, 0}: !\n",
        "Did you hear that, {STRVAR_1 3, 1, 0}?!\r",
        "That was the legendary Pokémon\n",
        "crying! That had to be it!\r",
        "OK! This is our chance!\n",
        "Let’s catch it!\r"
      ]
    },
    {
      "id": "LakeVerityLowWater_Text_WaitWeDontHavePokeballs",
      "en_US": [
        "...Wait!\n",
        "What...?!\r",
        "We don’t have anything on us!\r",
        "You know, Poké Balls!\n",
        "P-O-K-accent-E Balls!\r",
        "If we don’t have those, we can’t\n",
        "catch Pokémon or take them around\r",
        "with us!\r",
        "...Do you think Prof. Rowan’d give\n",
        "us some if we asked him?\r",
        "You know, you remember what he\n",
        "said, don’t you?\r",
        "He said to visit him at his lab if\n",
        "we needed anything.\r",
        "OK, {STRVAR_1 3, 1, 0}!\n",
        "I’ll race you!\r",
        "First one to the professor’s lab\n",
        "in Sandgem Town rules!\r"
      ]
    },
    {
      "id": "LakeVerityLowWater_Text_RowanNoLegendaryHowWasLakeValor",
      "en_US": [
        "Rowan: Hmmm...\r",
        "No legendary Pokémon, nothing out\n",
        "of the ordinary...\r",
        "{STRVAR_1 3, 0, 0}, how was Lake Valor?\n",
        "Anything to report?\r",
        "What? You’re just going there now?\n",
        "You’ve got to move faster than\r",
        "that!"
      ]
    },
    {
      "id": "LakeVerityLowWater_Text_RowanHowWasLakeValor",
      "en_US": [
        "Rowan: {STRVAR_1 3, 0, 0}, how was Lake\n",
        "Valor? Anything to report?\r",
        "What? You’re just going there now?\n",
        "You’ve got to move faster than\r",
        "that!"
      ]
    },
    {
      "id": "LakeVerityLowWater_Text_DawnHowHasLakeValor",
      "en_US": [
        "Dawn: {STRVAR_1 3, 0, 0}, how was\n",
        "Lake Valor?\r",
        "There’s nothing wrong here.\n",
        "The lake hasn’t changed at all.\r",
        "We haven’t found a legendary\n",
        "Pokémon, either, though..."
      ]
    },
    {
      "id": "LakeVerityLowWater_Text_LucasHowsLakeValor",
      "en_US": [
        "Lucas: Hiya, {STRVAR_1 3, 0, 0}!\n",
        "How’s Lake Valor?\r",
        "There’s nothing wrong here.\n",
        "The lake is ordinary, as usual.\r",
        "There’s no legendary Pokémon,\n",
        "either..."
      ]
    }
  ]
}
