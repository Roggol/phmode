  "messages": [
    {
      "id": "Route221House_Text_HereAreAllThree",
      "en_US": [
        "You there!\n",
        "Your trousers are falling down!\r",
        "Take these."
      ]
    },
    {
      "id": "Route221House_Text_PokemonIsCorrectLevel",
      "en_US": [
        "...I saw it!\n",
        "Today’s number is {STRVAR_1 51, 0, 0}!\r",
        "Show me a Pokémon that’s Lv. {STRVAR_1 51, 0, 0}.\n",
        "If you can, I’ll reward you.\r",
        "...Oh, now, hunh?!\r",
        "Your {STRVAR_1 0, 1, 0} is Lv. {STRVAR_1 51, 0, 0}.\n",
        "Well, I’ll be! How remarkable!\r",
        "I’ll thank you for that visual treat\n",
        "with this {STRVAR_1 8, 2, 0}.\r"
      ]
    },
    {
      "id": "Route221House_Text_NoRoomInBag",
      "en_US": [
        "Oh? You’ve no room in your Bag.\n",
        "I’ll hold it, so come back later."
      ]
    },
    {
      "id": "Route221House_Text_ThankWithItem",
      "en_US": [
        "Oh, right! Let me give you the rest\n",
        "of what I owe you."
      ]
    },
    {
      "id": "Route221House_Text_AlreadyGaveReward",
      "en_US": [
        "What do you mean you don’t\n",
        "wear trousers?\r",
        "Ungrateful child!"
      ]
    },
    {
      "id": "Route221House_Text_WinItemsFromMe",
      "en_US": [
        "Win Items from Me!\r",
        "Black Belt: Powers up Fighting-type\n",
        "moves.\r",
        "Expert Belt: Powers up moves if they\n",
        "are super effective.\r",
        "Focus Sash: The bearer avoids\n",
        "a one-hit KO if its HP is full."
      ]
    }
  ]
}
